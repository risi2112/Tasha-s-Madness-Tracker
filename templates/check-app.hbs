<div class="madness-check-form">
  <div class="form-group">
    <label>{{localize "MADNESS.CheckApp.Mode"}}</label>
    <div class="form-fields mode-fields">
      <label><input type="radio" name="mode" value="save" checked/> {{localize "MADNESS.CheckApp.ModeSave"}}</label>
      <label><input type="radio" name="mode" value="direct"/> {{localize "MADNESS.CheckApp.ModeDirect"}}</label>
    </div>
    <p class="hint">{{localize "MADNESS.CheckApp.ModeHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "MADNESS.CheckApp.Flavor"}}</label>
    <textarea name="flavor" rows="2" placeholder="{{localize 'MADNESS.CheckApp.FlavorPlaceholder'}}"></textarea>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>{{localize "MADNESS.CheckApp.DC"}}</label>
      <input type="number" name="dc" value="{{dc}}"/>
    </div>
    <div class="form-group">
      <label>{{localize "MADNESS.CheckApp.Ability"}}</label>
      <select name="ability">
        {{#each abilities as |label key|}}
          <option value="{{key}}" {{#if (eq key ../ability)}}selected{{/if}}>{{label.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "MADNESS.CheckApp.MadnessType"}}</label>
    <select name="madnessType">
      {{#each madnessTypes as |type|}}
        <option value="{{type.key}}">{{type.label}}</option>
      {{/each}}
    </select>
    <p class="hint">{{localize "MADNESS.CheckApp.MadnessTypeHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "MADNESS.CheckApp.Targets"}}</label>
    <div class="target-toolbar">
      <a data-action="selectAll">{{localize "MADNESS.CheckApp.All"}}</a>
      <a data-action="selectNone">{{localize "MADNESS.CheckApp.None"}}</a>
    </div>
    <div class="target-list">
      {{#each targets as |t|}}
        <label class="target-item">
          <input type="checkbox" name="targets" value="{{t.id}}" {{#if t.checked}}checked{{/if}}/>
          {{t.name}}
        </label>
      {{/each}}
      {{#unless targets.length}}
        <p class="hint">{{localize "MADNESS.CheckApp.NoActors"}}</p>
      {{/unless}}
    </div>
  </div>

  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-paper-plane"></i> {{localize "MADNESS.CheckApp.Send"}}</button>
  </footer>
</div>
